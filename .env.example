# BAYTAR — Environment Variables

# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...

# Edge Functions (service_role — سري جداً، ما يُنشر أبداً)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Onboarding secret (لإنشاء العيادات الجديدة)
SETUP_SECRET=choose-a-strong-secret-here

# Twilio (لاحقاً)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+1xxxxxxxxxx

# App
APP_URL=https://baytar.app
